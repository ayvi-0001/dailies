#!/usr/bin/env bash

set -euo pipefail

buffer_name=$1
current_working_directory=$2
src=$(cat -)

tmpsrc=$(
    mktemp -u -p "$(dirname "$buffer_name")" \
    --suffix .tsx \
    -- "$(basename -s .tsx "$buffer_name")-XXXXXXXXXXXX"
)

err() { echo "An error occurred on line $1"; rm "$tmpsrc"; exit 1; }
ok() { [[ $? -eq 0 ]] &&  rm "$tmpsrc"; }

trap 'err $LINENO' ERR
trap 'ok' EXIT

cd "$current_working_directory"
prettier --parser=typescript --stdin-filepath "$buffer_name" <<< "$src" > "$tmpsrc"
npx --no-install eslint --fix --stdin-filename "$buffer_name" -- "$tmpsrc" &>/dev/null
echo "$(<"$tmpsrc")"
